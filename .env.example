# Copy to .env and fill in. .env is gitignored.
# Gemini API key, from https://aistudio.google.com/apikey. Use a key from a project with no billing account,
# so it stays on the free tier. With the key set, the API asks Gemini for the skills of each task saved
# without any. Left empty, those tasks save with skillSource FAILED.
GEMINI_API_KEY=

# Optional; the defaults are shown. LLM_TIMEOUT_MS limits each attempt, at most 25000. A failed attempt is
# retried once, unless it was an HTTP 400, 401, 403 or 404, so the LLM part of a Save waits at most twice this.
# GEMINI_MODEL=gemini-3.5-flash-lite
# LLM_TIMEOUT_MS=20000

# Optional; the defaults are shown.
# LOG_LEVEL=info
# API_PORT=3000
# Applied only when the database volume is first created; after a change, run `docker compose down -v` (deletes all data).
# Use letters and digits only: it is placed unencoded into the API's DATABASE_URL.
# POSTGRES_PASSWORD=taskapp
