# Copy to .env and fill in. .env is gitignored.
# Gemini API key, from https://aistudio.google.com/apikey. The server only logs whether it is set: no skill
# identifier is connected, so a task saved without skills gets skillSource FAILED either way.
GEMINI_API_KEY=

# Optional; the defaults are shown.
# GEMINI_MODEL=gemini-3.5-flash-lite
# LLM_TIMEOUT_MS=10000
# LOG_LEVEL=info
# API_PORT=3000
# Applied only when the database volume is first created; after a change, run `docker compose down -v` (deletes all data).
# Use letters and digits only: it is placed unencoded into the API's DATABASE_URL.
# POSTGRES_PASSWORD=taskapp
